# =============================================================================
# AI-Powered Digital Twin of India's Climate — Environment Configuration
# =============================================================================

# --- Application ---
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- PostgreSQL + PostGIS ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=climatetwin
POSTGRES_USER=climatetwin
POSTGRES_PASSWORD=climatetwin_password
DATABASE_URL=postgresql+asyncpg://climatetwin:climatetwin_password@db:5432/climatetwin

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- MinIO Object Storage ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=climatetwin
MINIO_SECRET_KEY=climatetwin_secret
MINIO_BUCKET_DATASETS=climate-datasets
MINIO_BUCKET_MODELS=ai-models
MINIO_SECURE=false

# --- AI Module ---
MODEL_STORAGE_PATH=/app/ai/models/saved
AI_PREDICTION_HORIZON_DAYS=7
TRAINING_LOOKBACK_DAYS=30

# --- Data Sources (Real endpoints - leave blank for mock mode) ---
IMD_API_BASE_URL=
IMD_API_KEY=
MOSDAC_API_BASE_URL=
MOSDAC_API_KEY=
INSAT_FTP_HOST=
INSAT_FTP_USER=
INSAT_FTP_PASS=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_APP_NAME=ClimateTwin India
NEXT_PUBLIC_APP_VERSION=1.0.0

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
